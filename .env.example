# VOYO Music — environment variables (example)
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Vite-exposed vars must start with VITE_ — they're inlined into the client bundle.

# Supabase project (mclbbkmpovnvcfmwsoqt)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push (VAPID public key) — used by the bell on Home.
VITE_VAPID_PUBLIC_KEY=

# Lyrics API base URL (defaults to localhost:3099 when unset).
VITE_LYRICS_API_URL=

# Gemini API (oyo intent provider).
VITE_GEMINI_API_KEY=

# Internal API base (video intelligence service).
VITE_API_URL=

# ─── Classics Drop (Apr 2026) ───────────────────────────────────────────────
# When `true`, the All-Time Classics shelf on Home subscribes to the
# `voyo_classics_drops` Supabase table. If a live drop exists, the shelf
# transforms into a single-disc ceremony for the duration of the drop.
# When unset/false, the existing shelf renders unchanged.
#
# Per-device override (no redeploy):
#   localStorage.setItem('voyo:classics:drop:enabled', '1');
VITE_VOYO_CLASSICS_DROP_ENABLED=false
